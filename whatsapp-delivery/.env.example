# ספק החילוץ: anthropic | gemini
# אם לא מוגדר - נבחר gemini אוטומטית אם GEMINI_API_KEY קיים, אחרת anthropic
LLM_PROVIDER=

# מפתח ל-Claude (console.anthropic.com) - בתשלום לפי שימוש
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# מפתח ל-Gemini (aistudio.google.com/apikey) - יש free tier
GEMINI_API_KEY=
GEMINI_MODEL=

# שלב 3 (תמלול): Whisper מקומי (nodejs-whisper) מנסה קודם.
# דורש ffmpeg + build tools (make/gcc/cmake) מותקנים במערכת, ומוריד מודל
# אוטומטית בהרצה הראשונה. גודל המודל: tiny/base/small/medium/large (ברירת
# מחדל: small - איזון סביר בין דיוק למהירות על CPU).
WHISPER_MODEL=
WHISPER_MODEL_PATH=

# Fallback אם Whisper מקומי לא זמין/נכשל - Gemini (אותו GEMINI_API_KEY
# שהוגדר למעלה עבור extractor.js).

# שלב 4 (חיבור ווטסאפ): מספרי טלפון מורשים בלבד, מופרדים בפסיק (ספרות
# בלבד, עם קידומת מדינה, בלי + או רווחים - למשל 972501234567). ריק (ברירת
# מחדל) = מאזין לכל השיחות הפרטיות (לא קבוצות).
ALLOWED_PHONE_NUMBERS=

# שלב 5 (ממשק web): פורט וכתובת להאזנה. ברירת מחדל 127.0.0.1 - אין אימות
# על ה-API, לא מומלץ לחשוף לרשת בלי הגנה נוספת.
WEB_PORT=
WEB_HOST=
